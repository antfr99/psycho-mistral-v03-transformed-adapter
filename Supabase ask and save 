from supabase import create_client
from google.colab import userdata

supabase = create_client(userdata.get("SUPABASE_URL"), userdata.get("SUPABASE_KEY"))

def ask(q, max_new_tokens=120):
    """Generate an answer, save it to Supabase (ungraded), return the row id."""
    enc = tok.apply_chat_template(
        [{"role": "user", "content": q}],
        add_generation_prompt=True, return_tensors="pt", return_dict=True
    ).to(model.device)
    out = model.generate(**enc, max_new_tokens=max_new_tokens, do_sample=False,
                         repetition_penalty=1.1, pad_token_id=tok.eos_token_id)
    answer = tok.decode(out[0, enc["input_ids"].shape[-1]:], skip_special_tokens=True).strip()

    row = supabase.table("psycho_qa").insert({
        "question": q,
        "answer": answer,
        "grade": None          # graded later
    }).execute()
    row_id = row.data[0]["id"]

    print(f"[row {row_id}]  {q}\n")
    print(answer, "\n")
    print(f"→ to grade:  grade({row_id}, <1-10>)\n")
    return row_id

def grade(row_id, score):
    """Set the grade (1-10) on a row you've already read."""
    if not (1 <= score <= 10):
        print("grade must be 1-10"); return
    supabase.table("psycho_qa").update({"grade": score}).eq("id", row_id).execute()
    print(f"✅ row {row_id} graded {score}")

print("ready — use ask('your question'), then grade(row_id, score)")